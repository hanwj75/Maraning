# ============================================================
# FRONTEND ENV (Vite)
# ============================================================
# VITE_ prefix 값은 빌드 번들에 포함돼 브라우저에 노출됩니다.
# secret 또는 서버 전용 값은 절대 VITE_ prefix로 설정하지 마세요.

# Supabase 프로젝트 URL (필수)
# Edge Functions 호출 기본 URL: VITE_SUPABASE_URL/functions/v1 로 자동 유도됨
VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase anon public key (현재 미사용 — 프론트에서 Supabase 클라이언트 직접 사용 안 함)
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Edge Functions base URL (선택 — 설정 시 VITE_SUPABASE_URL 보다 우선 적용)
# VITE_SUPABASE_URL 을 설정하면 아래 값은 자동으로 https://your-project-ref.supabase.co/functions/v1 로 유도됨
# 다른 URL 을 직접 지정하려면 아래 주석을 풀고 입력
# VITE_API_BASE_URL=https://your-project-ref.supabase.co/functions/v1

# ============================================================
# SERVER SECRETS (Supabase Edge Functions only)
# ============================================================
# 아래 값은 절대 프론트 .env 에 넣지 마세요.
# 배포 환경: Supabase 대시보드 > Project Settings > Edge Functions > Secrets
# 로컬 개발: supabase secrets set KEY=VALUE
#
# SUPABASE_URL 과 SUPABASE_SERVICE_ROLE_KEY 는 Supabase 가 Edge Function 실행 환경에
# 자동으로 주입합니다. 로컬 supabase 개발 환경에서만 직접 설정이 필요합니다.
#
# 아래 항목들은 참고용이며 실제 값은 이 파일에 작성하지 않습니다.

# Supabase 프로젝트 URL (Edge Functions 에서 자동 주입됨)
# SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase service role key (필수, 프론트에 절대 노출 금지)
# SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# 앱 세션 JWT 서명 키 (필수)
# APP_SESSION_JWT_SECRET=your-app-session-jwt-secret

# 앱인토스 Toss API base URL (기본값: https://apps-in-toss-api.toss.im)
# TOSS_API_BASE_URL=https://apps-in-toss-api.toss.im

# 앱인토스 앱 식별값 (현재 Edge Functions 에서 미사용, IAP 연동 시 필요)
# TOSS_CLIENT_ID=ma-ra-ning

# 토스 개인정보 복호화 키 (현재 Edge Functions 에서 미사용, 개인정보 조회 시 필요)
# TOSS_DECRYPTION_KEY=your-toss-decryption-key
# TOSS_DECRYPTION_AAD=your-toss-decryption-aad
