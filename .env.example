# Frontend-exposed values. Only use VITE_ for values safe to ship to the client.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Optional override. When omitted, the frontend derives Supabase Edge Functions URL from VITE_SUPABASE_URL.
VITE_API_BASE_URL=https://your-project-ref.supabase.co/functions/v1

# Server-only secrets. Do NOT add VITE_ prefix.
# Set these with Supabase project secrets for Edge Functions, not in frontend env.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
TOSS_API_BASE_URL=https://api.toss.im
TOSS_CLIENT_ID=your-toss-client-id
TOSS_DECRYPTION_KEY=your-toss-decryption-key
TOSS_DECRYPTION_AAD=your-toss-decryption-aad
APP_SESSION_JWT_SECRET=your-app-session-jwt-secret
